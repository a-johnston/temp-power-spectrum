# Project dependencies only; Devbox adds the terminal runtime and selected harness.
# Those layers use apt and glibc, so keep a Debian or Ubuntu base.
FROM ubuntu:24.04

# Exact symbolic validation only; no numerical evolution/quadrature stack.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /opt/analysis-requirements.txt
RUN python3 -m venv /opt/analysis-venv \
    && /opt/analysis-venv/bin/pip install --no-cache-dir \
        -r /opt/analysis-requirements.txt
ENV PATH="/opt/analysis-venv/bin:${PATH}"

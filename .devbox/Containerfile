# Project dependencies only; Devbox adds the terminal runtime and selected harness.
# Those layers use apt and glibc, so keep a Debian or Ubuntu base.
FROM ubuntu:24.04

# Exact computer algebra for the analytical derivation and its symbolic checks:
#   - Python + SymPy/mpmath/SymEngine (primary CAS, scripts in verification/)
#   - Maxima (independent second CAS for cross-checking key identities)
#   - LaTeX toolchain to build approach/approach.tex and the problem statement
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git make \
      python3 python3-venv python3-pip \
      maxima \
      texlive-latex-base texlive-latex-recommended texlive-latex-extra \
      texlive-fonts-recommended texlive-science latexmk \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir \
      "sympy>=1.13" "mpmath>=1.3" symengine pytest
ENV PATH="/opt/venv/bin:${PATH}"

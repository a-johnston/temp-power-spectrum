# Project dependencies only; Devbox adds the terminal runtime and selected harness.
# Those layers use apt and glibc, so keep a Debian or Ubuntu base.
FROM ubuntu:24.04

# Exact computer algebra for the analytical derivation and its symbolic checks:
#   - Python + pinned SymPy/mpmath (primary CAS; solution/), numpy for the exploratory numerics
#   - Maxima (independent second CAS for cross-checking key identities)
#   - LaTeX toolchain to build the report
# Numerics (solution/numerics/) are exploratory only and never used as evidence.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git make \
      python3 python3-venv python3-pip \
      maxima \
      texlive-latex-base texlive-latex-recommended texlive-latex-extra \
      texlive-fonts-recommended texlive-science latexmk \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /opt/analysis-requirements.txt
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir -r /opt/analysis-requirements.txt
ENV PATH="/opt/venv/bin:${PATH}"
